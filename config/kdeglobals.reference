# applied by kwriteconfig6:
[General]
font=Noto Sans,10,-1,5,50,0,0,0,0,0

[Icons]
Theme=FairyWren_Light

# all [Colors:*], [ColorEffects:*], [WM] and [KDE] groups from the baseline are preserved.