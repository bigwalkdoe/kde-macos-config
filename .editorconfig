root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2

[*.js]
indent_size = 4

[*.md]
# trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[*.{conf,ini,desktop}]
# Plasma/KConfig snapshots: do not reformat, these are copied verbatim
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
